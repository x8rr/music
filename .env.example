# x8music runs on Bun, which loads .env from this directory on its own.
MUSIC_PORT= # defaults to 2010

# --- YouTube Music (the only source that plays audio) ---
# REQUIRED to play anything. There is no built-in host: set the origin to
# search and download from, with no trailing path. Unset, search still works
# (Tidal) but every stream answers 502.
YTM_BASE= # e.g. https://music.youtube.com

# Path to a system-installed yt-dlp. PATH is not searched: when unset the
# server tries /usr/local/bin/yt-dlp, then /usr/bin/yt-dlp. Keep it updated
# (yt-dlp -U) or downloads start failing.
YT_DLP_PATH=

# Invidious instance (host only, e.g. yt.example.org) that every download goes
# through instead of YTM_BASE, for servers YouTube bot-checks. Search falls back
# to it too when YTM_BASE refuses. First try is the instance's latest_version
# redirect, then the yt-dlp-invidious plugin if it is installed.
YTM_INVIDIOUS_INSTANCE= # empty: download straight from YTM_BASE
# Each yt-dlp run is a ~75MB Python process; this caps how many run at once.
YTM_MAX_CONCURRENT_DOWNLOADS= # defaults to 3
# How long to stop trying after a few tracks in a row come back with a bot
# check or 403, in milliseconds.
YTM_PARK_MS= # defaults to 300000

# --- R2 (album art and downloaded audio kept for good) ---
# There is no built-in bucket: bring your own. R2_BASE is your S3 API
# endpoint; any S3-compatible store works. The disk caches below hold the
# popular files and everything else is pulled back from here on a miss. Leave
# any of these empty to run on local disk only.
# The token only needs Object Read & Write on this one bucket.
R2_BASE= # e.g. https://<account id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Disk cache ceilings, in GB. A sweep every six hours removes the least
# recently read files until the cache is under its cap.
ART_CACHE_MAX_GB= # defaults to 5 with R2, 20 without
YTM_CACHE_MAX_GB= # defaults to 8
ART_CACHE_DIR= # defaults to data/art-cache
YTM_CACHE_DIR= # defaults to data/ytm-cache

# --- Tidal (search, albums, artists, artwork) ---
# Works out of the box; override only if the defaults stop working.
TIDAL_CLIENT_ID=
TIDAL_CLIENT_SECRET=
TIDAL_COUNTRY= # defaults to US
TIDAL_PROXY= # optional region proxy for api.tidal.com

# HiFi mirrors used when api.tidal.com fails. Defaults to the list in
# config/music-sources.json; a comma-separated list here replaces it.
MUSIC_API_BASES=
